APP_ENV=development
DATABASE_URL=sqlite:///./leverage.db
SECRET_KEY=change-me-in-real-environments
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
EMAIL_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_EMAIL_COOLDOWN_SECONDS=60
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
AI_SUGGESTIONS_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5
AI_SUGGESTIONS_TIMEOUT_SECONDS=30
WORLD_GYMNASTICS_TIMEOUT_SECONDS=10
